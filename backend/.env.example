# Environment Configuration
ENVIRONMENT=development  # development | production
DEBUG=True

# Django Secret Key — OBLIGATOIRE en production.
#
# Elle signe les JWT, les sessions, les jetons CSRF et les liens de
# réinitialisation de mot de passe. Qui la connaît peut forger un jeton pour
# n'importe quel compte, administrateur compris.
#
# En développement, une valeur de repli publique est utilisée si cette variable
# est absente. En production, l'application REFUSE DE DÉMARRER sans clé propre.
#
# Générer une clé :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Database Configuration
DB_NAME=learning_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-password

# AWS S3 (Optional - for production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-3

# Sentry (Optional - for production)
SENTRY_DSN=

# Production Settings
ALLOWED_HOSTS=localhost,127.0.0.1
