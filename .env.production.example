# Variables de la pile de production (docker-compose.prod.yml).
#
#   cp .env.production.example .env && $EDITOR .env
#
# ⚠️ Ce fichier est un modèle : le `.env` réel ne doit jamais être commité.

# ─── Domaine ────────────────────────────────────────────────────────────────
# Sous-domaine servi par le Traefik déjà en place. Doit exister en DNS (A vers
# l'IP du VPS, ou couvert par l'enregistrement wildcard) avant le démarrage,
# sinon Let's Encrypt échoue à délivrer le certificat.
DOMAIN=learning.tondomaine.fr

# Nom du certresolver déclaré dans la commande de Traefik. `myresolver` est
# celui du guide ; à ajuster si votre pile existante en utilise un autre.
CERT_RESOLVER=myresolver

# ─── Django ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False

# OBLIGATOIRE. `production.py` REFUSE DE DÉMARRER sans clé propre d'au moins
# 50 caractères — l'échec au démarrage vaut mieux qu'une compromission
# silencieuse, cette clé signant les JWT, les sessions, les jetons CSRF et les
# liens de réinitialisation de mot de passe.
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Doit contenir le domaine ci-dessus, sinon Django renvoie 400 sur toute
# requête (DisallowedHost).
ALLOWED_HOSTS=learning.tondomaine.fr

# Front et API étant sur le même hôte, une seule origine suffit.
CORS_ALLOWED_ORIGINS=https://learning.tondomaine.fr

# Base des liens envoyés par email (réinitialisation de mot de passe) et du
# lien vers l'espace d'administration depuis l'admin Django.
FRONTEND_URL=https://learning.tondomaine.fr

# ─── Base de données ────────────────────────────────────────────────────────
# ⚠️ Ne pas reprendre le postgres/postgres du développement.
DB_NAME=learning_platform
DB_USER=learning
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Exécution du code d'apprenant ──────────────────────────────────────────
# `False` sur un VPS mutualisé : activer l'exécution impose de monter
# /var/run/docker.sock dans le worker Celery, ce qui donne à qui contrôle ce
# worker la main sur le démon Docker, donc sur l'hôte, donc sur *tous* les
# projets hébergés. Théorie et quiz fonctionnent normalement ; les exercices
# sont refusés proprement et ne bloquent pas la progression.
#
# Ne repasser à True qu'après avoir isolé l'exécution (démon séparé, Sysbox,
# Podman sans privilèges) — et en remontant alors la socket dans la compose.
CODE_EXECUTION_ENABLED=False

# ─── Email ──────────────────────────────────────────────────────────────────
# Sans SMTP valide, « mot de passe oublié » échoue — l'envoi est synchrone,
# par choix (une réinitialisation est rare, et passer par Celery rendrait
# l'échec invisible).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Plateforme <no-reply@tondomaine.fr>

# ─── Divers ─────────────────────────────────────────────────────────────────
# 6 vCores disponibles : 4 workers laissent de la marge aux autres projets.
WEB_CONCURRENCY=4

# Facultatif — la remontée d'erreurs est déjà câblée (production.py).
SENTRY_DSN=
